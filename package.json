{
  "name": "hattery",
  "version": "0.1.0",
  "description": "Immutable, fluent HTTP requests with typed JSON and native fetch",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run test:imports && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "test:imports": "tsc -p test/consumer/tsconfig.node.json && tsc -p test/consumer/tsconfig.browser.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/stickfigure/hatteryjs.git"
  },
  "keywords": [
    "http",
    "fetch"
  ],
  "author": "Jeff Schnitzer",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/stickfigure/hatteryjs/issues"
  },
  "homepage": "https://github.com/stickfigure/hatteryjs#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  }
}
